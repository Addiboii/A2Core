    <EmbeddedResource Include="../../tools/data/boxes.json" LogicalName="boxes.json" />
    <EmbeddedResource Include="../../tools/data/levels.json" LogicalName="levels.json" />
    <EmbeddedResource Include="../../tools/data/loot.json" LogicalName="loot.json" />
