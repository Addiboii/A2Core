<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Aion.Infrastructure/Aion.Infrastructure.csproj" />
    <ProjectReference Include="../Aion.Protocol/Aion.Protocol.csproj" />
    <ProjectReference Include="../Aion.World/Aion.World.csproj" />
    <EmbeddedResource Include="../../tools/data/platform-goods.json" LogicalName="platform-goods.json" />
  </ItemGroup>
  <!-- The account page and staff dashboard (React, web/) build into wwwroot when their sources
       change. Needs Node.js and npm; AION_SKIP_WEB=1 skips it (pages then stay as last built). -->
  <ItemGroup>
    <WebSource Include="../../web/src/**/*;../../web/*.html;../../web/package-lock.json;../../web/vite.config.ts;../../web/tsconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Message names for the staff health page's request table (Ops/OpsEndpoints.cs). -->
    <EmbeddedResource Include="../../tools/data/opcode-names.json" LogicalName="opcode-names.json" />
  </ItemGroup>
  <Target Name="BuildWebPages" BeforeTargets="BeforeBuild" Inputs="@(WebSource)" Outputs="wwwroot/admin.html;wwwroot/index.html" Condition="'$(AION_SKIP_WEB)' != '1' And Exists('../../web/package.json')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="../../web" Condition="!Exists('../../web/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="../../web" />
  </Target>
</Project>
